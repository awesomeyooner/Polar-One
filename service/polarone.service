[Unit]
Description=Main Executable for running Polar One
After=multi-user.target

[Service]
User=aaron
WorkingDirectory=/home/aaron/Documents/Docker-Workspaces/PolarOne-Workspace
ExecStart=/home/aaron/Documents/Docker-Workspaces/PolarOne-Workspace/run.sh
Restart=always

[Install]
WantedBy=multi-user.target